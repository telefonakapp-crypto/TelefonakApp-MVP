{
  "name": "telefonak-backend",
  "version": "1.0.0",
  "description": "Backend for Telefonak app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node scripts/init-db.js",
    "test:catalog": "node --test --test-concurrency=1 security-tests/suites/13-smartwatch-catalog.test.js security-tests/suites/99-teardown.test.js",
    "test:phase2b": "node --test --test-concurrency=1 security-tests/suites/15-smartwatch-listing-api.test.js security-tests/suites/99-teardown.test.js",
    "test:phase2c": "node --test --test-concurrency=1 security-tests/suites/16-smartwatch-attributes.test.js security-tests/suites/99-teardown.test.js",
    "test:custom-listings": "node --test --test-concurrency=1 security-tests/suites/21-custom-listings.test.js security-tests/suites/99-teardown.test.js",
    "generate:phone-catalog": "node scripts/generatePhoneCatalogSql.js",
    "generate:watch-attributes": "node scripts/generateSmartwatchAttributesSql.js",
    "create-super-admin": "node scripts/create-super-admin.js",
    "test:security": "node security-tests/run.js",
    "test:env": "node --test config/env.test.js utils/otp.h4.test.js utils/adminToken.test.js utils/jwtIssAud.test.js utils/userColumns.test.js utils/rateLimitIdentity.test.js routes/listings.ownership.sql.test.js utils/imageContent.test.js utils/adminImageUpload.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "twilio": "^4.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
