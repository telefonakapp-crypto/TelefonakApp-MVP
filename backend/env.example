PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=telefonak
DB_USER=postgres
DB_PASSWORD=your_password

# Required in production: strong secret, 16+ characters (never commit real secrets)
JWT_SECRET=replace_with_a_long_random_secret

# Public origin used when building absolute /uploads/... image URLs.
# Use your LAN IP or staging/production host so devices never get localhost links.
# Examples:
#   local:      http://localhost:3000
#   LAN/device: http://192.168.1.10:3000
#   production: https://api.telefonak.com
BASE_URL=http://localhost:3000

# Comma-separated browser origins allowed by CORS (required when NODE_ENV=production).
# Include Admin Web origin(s). Mobile native apps typically omit Origin.
# Example: https://admin.telefonak.com,https://staging-admin.telefonak.com
# Local Admin Web: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Set to 1 when behind nginx / a load balancer so rate limits use the real client IP
# TRUST_PROXY=1

# Optional: force random OTP codes even in development (default: fixed 1234 in non-production)
# OTP_MODE=random

# Optional: used by npm run create-super-admin (non-interactive)
# SUPER_ADMIN_EMAIL=admin@telefonak.com
# SUPER_ADMIN_PASSWORD=change-me-now
# SUPER_ADMIN_FULL_NAME=Telefonak Super Admin

# Twilio SMS (required for real OTP delivery in production)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
