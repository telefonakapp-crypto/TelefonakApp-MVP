PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=telefonak
DB_USER=postgres
DB_PASSWORD=your_password

# JWT secrets — never commit real values.
# Production REQUIRES two distinct strong secrets (16+ characters). There is no
# production fallback to JWT_SECRET. Startup fails if either is missing, weak,
# or if the two values are identical.
JWT_CUSTOMER_SECRET=replace_with_a_distinct_customer_secret
JWT_ADMIN_SECRET=replace_with_a_distinct_admin_secret
# Development only: if the dedicated secrets above are unset, JWT_SECRET may be
# used as a shared fallback (with a console warning). Unused in production auth.
JWT_SECRET=replace_with_a_long_random_secret

# OTP HMAC pepper — required in production (min 16 characters, not a placeholder).
# Must be different from JWT_CUSTOMER_SECRET, JWT_ADMIN_SECRET, and JWT_SECRET.
# Development: if unset, OTP hashing falls back to the customer JWT secret (warning).
# Production: startup FAILS if OTP_PEPPER is missing, empty, weak, or a placeholder.
# Do not reuse a JWT secret as the pepper.
OTP_PEPPER=replace_with_a_long_random_pepper

# Customer access JWT lifetime (default 15m). Refresh tokens default to 30 days.
# CUSTOMER_ACCESS_TOKEN_TTL=15m
# CUSTOMER_REFRESH_TOKEN_TTL_DAYS=30

# Admin Web access JWT lifetime (default 8h). Logout is browser-only (no server revoke).
# Production refuses to start if this is longer than 24h.
# ADMIN_ACCESS_TOKEN_TTL=8h

# Public origin used when building absolute /uploads/... image URLs.
# Use your LAN IP or staging/production host so devices never get localhost links.
# Examples:
#   local:      http://localhost:3000
#   LAN/device: http://192.168.1.10:3000
#   production: https://api.telefonak.com
BASE_URL=http://localhost:3000

# Comma-separated browser origins allowed by CORS (required when NODE_ENV=production).
# Include Admin Web origin(s). Mobile native apps typically omit Origin.
# Example: https://admin.telefonak.com,https://staging-admin.telefonak.com
# Local Admin Web (include both hostname forms — browsers treat them as different origins)
#   http://localhost:5173
#   http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 when behind nginx / a load balancer so Express (and rate limits) see
# the real client IP from a single trusted hop. Do not set trust proxy to true.
# TRUST_PROXY=1

# Optional: force random OTP codes even in development (default: fixed 1234 in non-production)
# OTP_MODE=random

# Temporary TEST-ONLY one-phone OTP bypass (backend-controlled).
# Inactive unless TEST_OTP_BYPASS_ENABLED=true AND phone+code are valid.
# Phone must be a Jordanian mobile; the API stores the canonical 07XXXXXXXX form.
# Do not enable on real production. Do not reuse this for arbitrary numbers.
# TEST_OTP_BYPASS_ENABLED=false
# TEST_OTP_PHONE=07XXXXXXXX
# TEST_OTP_CODE=0000

# OTP Development Testing Mode (never active when NODE_ENV=production):
#   - Auto-on when NODE_ENV=development (higher phone/IP quotas, 5s resend, [DEV OTP] console logs)
#   - Or set OTP_DEV_MODE=true for non-production environments (e.g. staging-like local)
# OTP_DEV_MODE=true

# Optional: used by npm run create-super-admin (non-interactive)
# SUPER_ADMIN_EMAIL=admin@telefonak.com
# SUPER_ADMIN_PASSWORD=change-me-now
# SUPER_ADMIN_FULL_NAME=Telefonak Super Admin

# Twilio SMS — required to send OTP in production.
# Local development does NOT need Twilio (fixed OTP 1234; code may be returned in JSON).
# NODE_ENV=production: startup FAILS unless all three are set and valid,
# except when TEST_OTP_BYPASS_ENABLED=true with a valid TEST_OTP_PHONE and TEST_OTP_CODE.
#   TWILIO_ACCOUNT_SID   Twilio Account SID (starts with AC)
#   TWILIO_AUTH_TOKEN    Twilio Auth Token
#   TWILIO_PHONE_NUMBER  E.164 sender number (e.g. +9627…)
# Do not commit real credentials. Placeholder values below are rejected in production.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
