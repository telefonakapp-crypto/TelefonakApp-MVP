+  private func loadImageViaUIImageObject(
+    selectedImage: PHPickerResult,
+    itemProvider: NSItemProvider
+  ) async throws -> AssetInfo {
+    guard itemProvider.canLoadObject(ofClass: UIImage.self) else {
+      throw FailedToReadImageException()
+    }
+
+    let object = try await itemProvider.loadObject(ofClass: UIImage.self)
+    guard let image = (object as? UIImage)?.fixOrientation() else {
+      throw FailedToReadImageException()
+    }
+
+    guard let imageData = image.jpegData(compressionQuality: options.quality) else {
+      throw FailedToReadImageException()
+    }
+
+    let fileExtension = ".jpg"
+    let targetUrl = try generateUrl(withFileExtension: fileExtension)
+    try ImageUtils.write(imageData: imageData, to: targetUrl)
+
+    return AssetInfo(
+      assetId: selectedImage.assetIdentifier,
+      uri: targetUrl.absoluteString,
+      width: Double(image.size.width),
+      height: Double(image.size.height),
+      fileName: itemProvider.suggestedName.map { $0 + fileExtension },
+      fileSize: getFileSize(from: targetUrl),
+      mimeType: "image/jpeg",
+      base64: options.base64 ? imageData.base64EncodedString() : nil,
+      exif: nil
+    )
+  }
+
+  private func loadImageViaPhotoLibraryAsset(
+    selectedImage: PHPickerResult,
+    itemProvider: NSItemProvider
+  ) async throws -> AssetInfo {
+    guard let assetId = selectedImage.assetIdentifier else {
+      throw FailedToReadImageException()
+    }
+
+    let fetchResult = PHAsset.fetchAssets(withLocalIdentifiers: [assetId], options: nil)
+    guard let asset = fetchResult.firstObject else {
+      throw FailedToReadImageException()
+    }
+
+    let rawData: Data = try await withCheckedThrowingContinuation { continuation in
+      let requestOptions = PHImageRequestOptions()
+      requestOptions.isNetworkAccessAllowed = true
+      requestOptions.deliveryMode = .highQualityFormat
+      requestOptions.resizeMode = .none
+      requestOptions.version = .current
+
+      PHImageManager.default().requestImageDataAndOrientation(
+        for: asset,
+        options: requestOptions
+      ) { data, _, _, info in
+        if let data {
+          continuation.resume(returning: data)
+          return
+        }
+        let error = (info?[PHImageErrorKey] as? Error) ?? FailedToReadImageException()
+        continuation.resume(throwing: error)
+      }
+    }
+
+    return try makeAssetInfo(
+      from: rawData,
+      selectedImage: selectedImage,
+      itemProvider: itemProvider
+    )
+  }
