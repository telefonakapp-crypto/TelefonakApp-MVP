+    // Try every registered image UTI. On some iOS Simulator Photos assets the first
+    // identifier is `public.jpeg` but that representation cannot be loaded, while
+    // another registered type (or a later fallback) still can.
+    var typeIdentifiers = registeredTypeIdentifiers()
+      .compactMap { UTType($0) }
+      .filter { $0.conforms(to: .image) }
+      .map(\.identifier)
+
+    if typeIdentifiers.isEmpty {
+      typeIdentifiers = [
+        UTType.image.identifier,
+        UTType.jpeg.identifier,
+        UTType.png.identifier,
+        UTType.heic.identifier,
+      ]
+    }
+
+    var lastError: Error?
+    for typeIdentifier in typeIdentifiers {
+      do {
+        return try await loadDataRepresentationAsync(forTypeIdentifier: typeIdentifier)
+      } catch {
+        lastError = error
+      }
+    }
+
+    throw FailedToReadImageException().causedBy(lastError)
+  }
+
+  private func loadDataRepresentationAsync(forTypeIdentifier typeIdentifier: String) async throws -> Data {
+    try await withCheckedThrowingContinuation { continuation in
+      loadDataRepresentation(forTypeIdentifier: typeIdentifier) { data, error in
         if let data {
           continuation.resume(returning: data)
         } else {
-          continuation.resume(throwing: FailedToReadImageException().causedBy(error))
+          continuation.resume(throwing: error ?? FailedToReadImageException())
         }
       }
