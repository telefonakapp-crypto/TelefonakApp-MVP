# Backend origin for the mobile app (no trailing slash; /api optional).
# Expo inlines EXPO_PUBLIC_* at bundle time — restart Metro after changing.
#
# Local development (this file):
#   iOS Simulator:    http://localhost:3000
#   Android Emulator: http://10.0.2.2:3000
#   Physical device:  http://YOUR_LAN_IP:3000   (e.g. http://192.168.1.10:3000)
#
# Store / Release builds:
#   EXPO_PUBLIC_API_URL is REQUIRED and must be https:// (not localhost / HTTP).
#   The Release bundle fails if this is missing or invalid. Do not commit real
#   production values here — set them in the release environment / CI secrets.

EXPO_PUBLIC_API_URL=http://localhost:3000
